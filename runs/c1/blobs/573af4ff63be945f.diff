@@ -0,0 +1,56 @@
+import unittest
+
+from app import export_csv
+
+
+class ExportCsvTests(unittest.TestCase):
+    def test_empty_rows_give_empty_string(self) -> None:
+        self.assertEqual(export_csv([]), "")
+
+    def test_header_uses_first_row_key_order(self) -> None:
+        rows = [{"name": "ada", "id": 1, "score": 9.5}]
+        self.assertEqual(export_csv(rows), "name,id,score\nada,1,9.5\n")
+
+    def test_header_only_when_row_has_no_values_beyond_keys(self) -> None:
+        self.assertEqual(export_csv([{"a": 1}]), "a\n1\n")
+
+    def test_every_line_is_newline_terminated(self) -> None:
+        text = export_csv([{"a": 1, "b": 2}, {"a": 3, "b": 4}])
+        self.assertEqual(text, "a,b\n1,2\n3,4\n")
+        self.assertTrue(text.endswith("\n"))
+        self.assertNotIn("\r", text)
+        self.assertEqual(text.splitlines(), ["a,b", "1,2", "3,4"])
+
+    def test_multiple_rows_are_written_in_order(self) -> None:
+        rows = [{"a": "x", "b": "y"}, {"a": "1", "b": "2"}, {"a": "3", "b": "4"}]
+        self.assertEqual(export_csv(rows), "a,b\nx,y\n1,2\n3,4\n")
+
+    def test_values_are_stringified(self) -> None:
+        self.assertEqual(export_csv([{"n": 7, "f": 1.5, "z": None}]), "n,f,z\n7,1.5,\n")
+
+    def test_special_characters_are_quoted(self) -> None:
+        rows = [{"text": 'has,comma', "quote": 'has"quote', "plain": "ok"}]
+        self.assertEqual(
+            export_csv(rows),
+            'text,quote,plain\n"has,comma","has""quote",ok\n',
+        )
+
+    def test_embedded_newline_is_quoted(self) -> None:
+        self.assertEqual(export_csv([{"a": "1\n2"}]), 'a\n"1\n2"\n')
+
+    def test_missing_key_in_later_row_becomes_empty_field(self) -> None:
+        rows = [{"a": 1, "b": 2}, {"a": 3}]
+        self.assertEqual(export_csv(rows), "a,b\n1,2\n3,\n")
+
+    def test_extra_key_in_later_row_is_rejected(self) -> None:
+        with self.assertRaises(ValueError):
+            export_csv([{"a": 1}, {"a": 2, "b": 3}])
+
+    def test_input_rows_are_not_mutated(self) -> None:
+        rows = [{"a": 1, "b": 2}]
+        export_csv(rows)
+        self.assertEqual(rows, [{"a": 1, "b": 2}])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_pagination.py b/tests/test_pagination.py
index 3d75241..ca6a26b 100644
--- a/tests/test_pagination.py
+++ b/tests/test_pagination.py
@@ -14,6 +14,40 @@ class PaginationTests(unittest.TestCase):
         with self.assertRaises(ValidationError):
             parse_pagination({"offset": "-1"})
 
+    def test_limit_above_maximum_is_capped(self) -> None:
+        self.assertEqual(parse_pagination({"limit": "500"}), {"limit": 100, "offset": 0})
+
+    def test_integer_values_are_accepted(self) -> None:
+        self.assertEqual(parse_pagination({"limit": 5, "offset": 10}), {"limit": 5, "offset": 10})
+
+    def test_whitespace_is_stripped(self) -> None:
+        self.assertEqual(parse_pagination({"limit": " 30 ", "offset": " 2 "}), {"limit": 30, "offset": 2})
+
+    def test_missing_or_none_values_fall_back_to_defaults(self) -> None:
+        self.assertEqual(parse_pagination({"limit": None, "offset": None}), {"limit": 20, "offset": 0})
+
+    def test_non_integer_limit_is_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            parse_pagination({"limit": "abc"})
+        with self.assertRaises(ValidationError):
+            parse_pagination({"limit": "1.5"})
+
+    def test_negative_limit_is_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            parse_pagination({"limit": "-5"})
+
+    def test_non_integer_types_are_rejected(self) -> None:
+        for value in (True, 1.5, [1], {"a": 1}):
+            with self.subTest(value=value):
+                with self.assertRaises(ValidationError):
+                    parse_pagination({"offset": value})
+
+    def test_validation_error_uses_http_400(self) -> None:
+        self.assertEqual(ValidationError.code, 400)
+        with self.assertRaises(ValidationError) as ctx:
+            parse_pagination({"offset": "-1"})
+        self.assertEqual(ctx.exception.code, 400)
+
 
 if __name__ == "__main__":
     unittest.main()
