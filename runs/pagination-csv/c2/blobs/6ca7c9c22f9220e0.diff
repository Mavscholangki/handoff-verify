+    def test_limit_above_maximum_is_capped(self) -> None:
+        self.assertEqual(parse_pagination({"limit": "500"}), {"limit": 100, "offset": 0})
+
+    def test_integer_values_are_accepted(self) -> None:
+        self.assertEqual(parse_pagination({"limit": 5, "offset": 10}), {"limit": 5, "offset": 10})
+
+    def test_whitespace_is_stripped(self) -> None:
+        self.assertEqual(parse_pagination({"limit": " 30 ", "offset": " 2 "}), {"limit": 30, "offset": 2})
+
+    def test_missing_or_none_values_fall_back_to_defaults(self) -> None:
+        self.assertEqual(parse_pagination({"limit": None, "offset": None}), {"limit": 20, "offset": 0})
+
+    def test_non_integer_limit_is_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            parse_pagination({"limit": "abc"})
+        with self.assertRaises(ValidationError):
+            parse_pagination({"limit": "1.5"})
+
+    def test_negative_limit_is_rejected(self) -> None:
+        with self.assertRaises(ValidationError):
+            parse_pagination({"limit": "-5"})
+
+    def test_non_integer_types_are_rejected(self) -> None:
+        for value in (True, 1.5, [1], {"a": 1}):
+            with self.subTest(value=value):
+                with self.assertRaises(ValidationError):
+                    parse_pagination({"offset": value})
+
+    def test_validation_error_uses_http_400(self) -> None:
+        self.assertEqual(ValidationError.code, 400)
+        with self.assertRaises(ValidationError) as ctx:
+            parse_pagination({"offset": "-1"})
+        self.assertEqual(ctx.exception.code, 400)
+
 
 if __name__ == "__main__":
     unittest.main()
