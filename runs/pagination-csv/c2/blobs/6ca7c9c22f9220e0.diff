@@ -0,0 +1,42 @@
+import csv
+import io
+import unittest
+
+from app import export_csv
+
+
+class ExportCsvTests(unittest.TestCase):
+    def test_empty_rows_return_empty_string(self) -> None:
+        self.assertEqual(export_csv([]), "")
+
+    def test_header_comes_from_first_row_keys_in_order(self) -> None:
+        rows = [{"name": "Bob", "id": 2}, {"name": "Alice", "id": 1}]
+        self.assertEqual(export_csv(rows), "name,id\nBob,2\nAlice,1\n")
+
+    def test_single_row_still_has_a_header(self) -> None:
+        self.assertEqual(export_csv([{"a": 1, "b": 2}]), "a,b\n1,2\n")
+
+    def test_output_is_newline_terminated(self) -> None:
+        text = export_csv([{"a": 1}, {"a": 2}])
+        self.assertTrue(text.endswith("\n"))
+        self.assertEqual(text.splitlines(), ["a", "1", "2"])
+
+    def test_special_characters_are_quoted(self) -> None:
+        rows = [{"text": 'has, comma', "quote": 'say "hi"'}]
+        self.assertEqual(export_csv(rows), 'text,quote\n"has, comma","say ""hi"""\n')
+
+    def test_missing_keys_become_empty_fields_and_extra_keys_are_ignored(self) -> None:
+        rows = [{"a": 1, "b": 2}, {"a": 3, "c": 4}]
+        self.assertEqual(export_csv(rows), "a,b\n1,2\n3,\n")
+
+    def test_none_values_become_empty_fields(self) -> None:
+        self.assertEqual(export_csv([{"a": None, "b": 1}]), "a,b\n,1\n")
+
+    def test_round_trips_through_the_csv_module(self) -> None:
+        rows = [{"id": 1, "name": "Ada"}, {"id": 2, "name": "Grace Hopper"}]
+        parsed = list(csv.reader(io.StringIO(export_csv(rows))))
+        self.assertEqual(parsed, [["id", "name"], ["1", "Ada"], ["2", "Grace Hopper"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
